{
  "version": 8,
  "max_models": 8,
  "matrix_only": true,
  "openrouter_prefix": "",
  "hard_exclude": [
    "--",
    "1-----"
  ],
  "exclude_patterns": [
    "kling-",
    "seedance",
    "sora-",
    "hailuo-",
    "grok-imagine",
    "utility$",
    "embed",
    "whisper",
    "rerank",
    "gemma-",
    "llama-4",
    "gpt-oss",
    "seed-2",
    "gpt-chat-latest",
    "deepseek-v4-flash",
    "solar-pro",
    "claude-mythos",
    ":batch$",
    "flux",
    "recraft",
    "seedream",
    "wan-",
    "riverflow",
    "gpt-.*-image",
    "gpt-5.6-terra",
    "gpt-5.6-sol-pro",
    "gpt-5.6-luna-pro",
    "gemini-3.1",
    "qwen3",
    "kimi-k2",
    "veo-"
  ],
  "pinned_suffixes": [
    "openai.gpt-5.6-sol",
    "openai.gpt-5.6-luna",
    "anthropic.claude-fable-5",
    "anthropic.claude-opus-4.8",
    "deepseek.deepseek-v4-pro",
    "perplexity.sonar-deep-research",
    "x-ai.grok-4.20-multi-agent",
    "google.gemini-3-pro-image"
  ],
  "mode_models": {
    "web_dev": {
      "primary": "anthropic.claude-fable-5",
      "fallbacks": [
        "anthropic.claude-opus-4.8",
        "deepseek.deepseek-v4-pro",
        "openai.gpt-5.6-sol"
      ]
    },
    "web_landing": {
      "primary": "anthropic.claude-fable-5",
      "fallbacks": [
        "anthropic.claude-opus-4.8",
        "openai.gpt-5.6-sol"
      ]
    },
    "prompt_master": {
      "primary": "openai.gpt-5.6-luna",
      "fallbacks": [
        "anthropic.claude-fable-5",
        "anthropic.claude-opus-4.8"
      ]
    },
    "deep_research": {
      "primary": "perplexity.sonar-deep-research",
      "fallbacks": [
        "x-ai.grok-4.20-multi-agent",
        "openai.gpt-5.6-sol"
      ]
    },
    "image_gen": {
      "primary": "google.gemini-3-pro-image",
      "fallbacks": []
    },
    "chat": {
      "primary": "openai.gpt-5.6-luna",
      "fallbacks": [
        "anthropic.claude-fable-5",
        "anthropic.claude-opus-4.8"
      ]
    },
    "browser_automation": {
      "primary": "anthropic.claude-fable-5",
      "fallbacks": [
        "anthropic.claude-opus-4.8",
        "openai.gpt-5.6-sol"
      ]
    },
    "browser_agent": {
      "primary": "anthropic.claude-fable-5",
      "fallbacks": [
        "anthropic.claude-opus-4.8",
        "openai.gpt-5.6-sol"
      ]
    },
    "web_crawl": {
      "primary": "openai.gpt-5.6-sol",
      "fallbacks": [
        "perplexity.sonar-deep-research",
        "openai.gpt-5.6-luna"
      ]
    }
  },
  "model_families": [
    {
      "match": [
        "gpt-5.6-sol",
        "gpt-5.6-luna"
      ],
      "max_keep": 2,
      "prefer_drop": [
        "-pro"
      ]
    },
    {
      "match": [
        "claude-fable-5"
      ],
      "max_keep": 1
    },
    {
      "match": [
        "claude-opus-4.8"
      ],
      "max_keep": 1,
      "prefer_drop": [
        "-fast"
      ]
    },
    {
      "match": [
        "gemini-3-pro-image",
        "gemini-3-pro-image-preview"
      ],
      "max_keep": 1
    },
    {
      "match": [
        "deepseek-v4-pro"
      ],
      "max_keep": 1
    },
    {
      "match": [
        "grok-4.20-multi-agent"
      ],
      "max_keep": 1
    },
    {
      "match": [
        "sonar-deep-research"
      ],
      "max_keep": 1
    }
  ],
  "categories": {
    "image": {
      "patterns": [
        "gemini-3-pro-image"
      ]
    },
    "coding": {
      "patterns": [
        "claude-fable-5",
        "deepseek-v4-pro",
        "gpt-5.6-sol"
      ]
    },
    "reasoning": {
      "patterns": [
        "sonar-deep-research",
        "deepseek-v4-pro",
        "opus-4",
        "grok-4",
        "multi-agent",
        "gpt-5.6-sol"
      ]
    },
    "longctx": {
      "patterns": [
        "opus-4",
        "claude-fable-5",
        "gpt-5.6-luna"
      ]
    },
    "fast": {
      "patterns": [
        "__none__"
      ]
    },
    "general": {
      "patterns": [
        ".*"
      ]
    }
  },
  "category_priority": [
    "image",
    "coding",
    "reasoning",
    "longctx",
    "general"
  ],
  "category_quotas": {
    "general": 2,
    "coding": 3,
    "reasoning": 3,
    "image": 1,
    "fast": 0,
    "longctx": 2
  },
  "tier_patterns": {
    "general": {
      "S": [
        "gpt-5.6-luna",
        "claude-fable-5",
        "claude-opus-4.8"
      ]
    },
    "coding": {
      "S": [
        "claude-fable-5",
        "deepseek-v4-pro",
        "claude-opus-4.8",
        "gpt-5.6-sol"
      ]
    },
    "reasoning": {
      "S": [
        "sonar-deep-research",
        "grok-4.20-multi-agent",
        "gpt-5.6-sol",
        "claude-opus-4.8"
      ]
    },
    "image": {
      "S": [
        "gemini-3-pro-image"
      ]
    },
    "longctx": {
      "S": [
        "gpt-5.6-luna",
        "claude-fable-5",
        "claude-opus-4.8"
      ]
    }
  },
  "mode_defaults": {
    "chat": "general",
    "cqr_concept": "general",
    "cqr_market": "reasoning",
    "web_dev": "coding",
    "web_landing": "coding",
    "prompt_master": "general",
    "deep_research": "reasoning",
    "image_gen": "image"
  },
  "default_model_suffix": "anthropic.claude-fable-5",
  "default_model_suffix_fallbacks": [
    "anthropic.claude-opus-4.8",
    "openai.gpt-5.6-sol",
    "openai.gpt-5.6-luna",
    "deepseek.deepseek-v4-pro"
  ]
}
