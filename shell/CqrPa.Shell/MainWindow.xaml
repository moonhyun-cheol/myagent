<Window x:Class="CqrPa.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MY Agent"
        Width="1100" Height="780"
        MinWidth="640" MinHeight="480"
        Background="#dde1de"
        BorderBrush="#adb9b4"
        BorderThickness="1"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#17211d" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#d3dad6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#c2cbc6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#c42b1c" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#a52316" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- RootLayout fills the window. Maximize snaps to monitor work area
       (taskbar excluded) via MaximizeWorkArea — do not rely on WindowState.Maximized alone. -->
  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar — matte gray + teal accent (matches workspace palette).
         Do NOT set IsHitTestVisibleInChrome on this Border: WindowChrome needs the
         caption strip for DragMove. Only the min/max/close buttons opt into chrome hits. -->
    <Border Grid.Row="0"
            Background="#f4f5f2"
            BorderBrush="#adb9b4"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    IsHitTestVisible="False">
          <Border Width="3" Height="14" CornerRadius="1" Background="#0f8f83" Margin="0,0,10,0" />
          <TextBlock Text="MY Agent"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="#17211d"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionBtn}"
                  Content="&#xE921;"
                  Click="OnMinimizeClick"
                  ToolTip="최소화"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button x:Name="MaximizeButton"
                  Style="{StaticResource CaptionBtn}"
                  Content="&#xE922;"
                  Click="OnMaximizeClick"
                  ToolTip="최대화"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource CaptionCloseBtn}"
                  Content="&#xE8BB;"
                  Click="OnCloseClick"
                  ToolTip="닫기"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <!-- The workspace WebView remains the CQRPA application surface. -->
      <wv2:WebView2 x:Name="WebView" />

      <Border x:Name="StartupOverlay"
              Background="#dde1de"
              Panel.ZIndex="20">
        <StackPanel Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Border Width="52" Height="52"
                  HorizontalAlignment="Center"
                  CornerRadius="16"
                  Background="#d8ebe7"
                  BorderBrush="#0f8f83"
                  BorderThickness="1">
            <TextBlock Text="C"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0b7068" />
          </Border>
          <TextBlock Text="MY Agent를 준비하고 있습니다"
                     Margin="0,18,0,6"
                     TextAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#17211d" />
          <TextBlock x:Name="StartupStatusText"
                     Text="로컬 서비스를 시작하는 중…"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="#4f5d57" />
          <ProgressBar x:Name="StartupProgress"
                       Margin="48,18,48,0"
                       Height="3"
                       IsIndeterminate="True"
                       Foreground="#0f8f83"
                       Background="#adb9b4" />
          <Button x:Name="StartupRetryButton"
                  Visibility="Collapsed"
                  Content="다시 시도"
                  Width="96"
                  Margin="0,18,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Center"
                  Click="OnStartupRetryClick" />
        </StackPanel>
      </Border>

      <!-- External pages are isolated in a second WebView2 so navigation never replaces the workspace. -->
      <Border x:Name="InAppBrowserPanel"
              Visibility="Collapsed"
              HorizontalAlignment="Right"
              Width="560"
              Background="#dde1de"
              BorderBrush="#adb9b4"
              BorderThickness="1,0,0,0"
              Panel.ZIndex="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="10,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="←" Click="OnBrowserBackClick" ToolTip="뒤로" />
            <Button Grid.Column="1" Content="→" Click="OnBrowserForwardClick" ToolTip="앞으로" />
            <Button Grid.Column="2" Content="↻" Click="OnBrowserReloadClick" ToolTip="새로고침" />
            <TextBox x:Name="BrowserAddressBox"
                     Grid.Column="3"
                     Margin="7,0"
                     VerticalContentAlignment="Center"
                     KeyDown="OnBrowserAddressKeyDown"
                     ToolTip="https:// 주소를 입력하세요" />
            <Button Grid.Column="4" Content="↗" Click="OnBrowserOpenExternalClick" ToolTip="기본 브라우저에서 열기" />
            <Button Grid.Column="5" Content="×" Click="OnBrowserCloseClick" ToolTip="인앱 브라우저 닫기" />
          </Grid>

          <TextBlock x:Name="BrowserStatusText"
                     Grid.Row="1"
                     Margin="12,0"
                     Foreground="#4f5d57"
                     FontSize="11"
                     Text="외부 링크를 앱 안에서 안전하게 엽니다." />

          <wv2:WebView2 x:Name="BrowserWebView" Grid.Row="2" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
