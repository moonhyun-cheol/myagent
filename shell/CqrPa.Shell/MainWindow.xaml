<Window x:Class="CqrPa.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MY Agent"
        Width="1100" Height="780"
        MinWidth="640" MinHeight="480"
        Background="{DynamicResource ShellWindowBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Light defaults are replaced at runtime when the workspace resolves to dark. -->
    <SolidColorBrush x:Key="ShellWindowBrush" Color="#dde1de" />
    <SolidColorBrush x:Key="ShellTitleBarBrush" Color="#f4f5f2" />
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#adb9b4" />
    <SolidColorBrush x:Key="ShellTextBrush" Color="#17211d" />
    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#4f5d57" />
    <SolidColorBrush x:Key="ShellHoverBrush" Color="#d3dad6" />
    <SolidColorBrush x:Key="ShellPressedBrush" Color="#c2cbc6" />
    <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#d8ebe7" />
    <SolidColorBrush x:Key="ShellAccentTextBrush" Color="#0b7068" />
    <SolidColorBrush x:Key="ShellProgressTrackBrush" Color="#adb9b4" />

    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ShellHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ShellPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StartupRetryBtn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ShellTitleBarBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    </Style>
    <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#c42b1c" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#a52316" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- RootLayout fills the window. Maximize snaps to monitor work area
       (taskbar excluded) via MaximizeWorkArea — do not rely on WindowState.Maximized alone. -->
  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar — matte gray + teal accent (matches workspace palette).
         Do NOT set IsHitTestVisibleInChrome on this Border: WindowChrome needs the
         caption strip for DragMove. Only the min/max/close buttons opt into chrome hits. -->
    <Border Grid.Row="0"
            Background="{DynamicResource ShellTitleBarBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    IsHitTestVisible="False">
          <Border Width="3" Height="14" CornerRadius="1" Background="#0f8f83" Margin="0,0,10,0" />
          <TextBlock Text="MY Agent"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ShellTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionBtn}"
                  Content="&#xE921;"
                  Click="OnMinimizeClick"
                  ToolTip="최소화"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button x:Name="MaximizeButton"
                  Style="{StaticResource CaptionBtn}"
                  Content="&#xE922;"
                  Click="OnMaximizeClick"
                  ToolTip="최대화"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource CaptionCloseBtn}"
                  Content="&#xE8BB;"
                  Click="OnCloseClick"
                  ToolTip="닫기"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="BrowserLayout" Grid.Row="1" SizeChanged="OnBrowserLayoutSizeChanged">
      <!-- Composition workspace has no competing child HWND. The native page occupies
           only the reserved DOM slot, never an extra column or a duplicate toolbar. -->
      <wv2:WebView2CompositionControl x:Name="WebView" />

      <Border x:Name="StartupOverlay"
              Background="{DynamicResource ShellWindowBrush}"
              Panel.ZIndex="20">
        <StackPanel Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Border Width="52" Height="52"
                  HorizontalAlignment="Center"
                  CornerRadius="16"
                  Background="{DynamicResource ShellAccentSoftBrush}"
                  BorderBrush="#0f8f83"
                  BorderThickness="1">
            <TextBlock Text="C"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ShellAccentTextBrush}" />
          </Border>
          <TextBlock Text="MY Agent를 준비하고 있습니다"
                     Margin="0,18,0,6"
                     TextAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ShellTextBrush}" />
          <TextBlock x:Name="StartupStatusText"
                     Text="로컬 서비스를 시작하는 중…"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{DynamicResource ShellMutedTextBrush}" />
          <ProgressBar x:Name="StartupProgress"
                       Margin="48,18,48,0"
                       Height="3"
                       IsIndeterminate="True"
                       Foreground="#0f8f83"
                       Background="{DynamicResource ShellProgressTrackBrush}" />
          <Button x:Name="StartupRetryButton"
                  Visibility="Collapsed"
                  Content="다시 시도"
                  Width="96"
                  Margin="0,18,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Center"
                  Style="{StaticResource StartupRetryBtn}"
                  Click="OnStartupRetryClick" />
        </StackPanel>
      </Border>

      <!-- External pages are isolated in a second WebView2 so navigation never replaces the workspace.
           Each browser tab is a child of this canvas; only the active tab is shown. -->
      <Canvas x:Name="BrowserTabCanvas" ClipToBounds="True">
        <Border x:Name="InAppBrowserPanel" Visibility="Collapsed" Background="{DynamicResource ShellWindowBrush}">
          <wv2:WebView2 x:Name="BrowserWebView" />
        </Border>
      </Canvas>
    </Grid>
  </Grid>
</Window>
